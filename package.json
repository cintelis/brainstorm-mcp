{
  "name": "@cintelisai/guardstein-mcp",
  "version": "0.4.1",
  "description": "MCP server for GuardStein (formerly Brainstorm Board): connect Claude to your workspace with SSO device-flow sign-in, no API keys. Read and write notes, upload files, and add editable draw.io diagrams.",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "guardstein-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "lib.mjs"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "author": "Cintelis Pty Limited",
  "homepage": "https://guardstein.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cintelis/brainstorm-mcp.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "guardstein",
    "notes",
    "drawio",
    "diagrams",
    "device-flow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "mammoth": "^1.12.0",
    "unpdf": "^1.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  }
}
